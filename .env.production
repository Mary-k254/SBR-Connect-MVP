# =====================================================
# SMART RIDE CONNECT - PRODUCTION ENVIRONMENT
# =====================================================
# Copy these values to Vercel Dashboard → Settings → Environment Variables
# IMPORTANT: Use "Production" scope for all variables

# =====================================================
# DATABASE (Required)
# =====================================================
# Supabase connection string - GET THIS FROM:
# https://supabase.com/dashboard → Your Project → Settings → Database
# Connection string format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.jmrgooqidunwswiqhkie.supabase.co:5432/postgres

# =====================================================
# SUPABASE CONFIGURATION (Optional - for client auth)
# =====================================================
NEXT_PUBLIC_SUPABASE_URL=https://db.jmrgooqidunwswiqhkie.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# =====================================================
# AUTHENTICATION (Required)
# =====================================================
# Generate a secure JWT secret:
# Run: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-generate-with-openssl

# =====================================================
# API CONFIGURATION
# =====================================================
NODE_ENV=production
API_URL=https://your-project.vercel.app
API_RATE_LIMIT=100

# =====================================================
# M-PESA (Optional - for mobile payments)
# =====================================================
# MPESA_CONSUMER_KEY=your-mpesa-consumer-key
# MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
# MPESA_SHORTCODE=your-mpesa-shortcode
# MPESA_PASSKEY=your-mpesa-passkey
# MPESA_ENV=production

# =====================================================
# EXTERNAL APIs (Optional)
# =====================================================
# MAPS_API_KEY=your-google-maps-api-key
# SMS_API_KEY=your-sms-api-key
