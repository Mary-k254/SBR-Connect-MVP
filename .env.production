# =====================================================
# SMART RIDE CONNECT - PRODUCTION ENVIRONMENT
# =====================================================
# IMPORTANT: These variables MUST be set in Vercel Dashboard
# Go to: Vercel → Your Project → Settings → Environment Variables
# Add each variable with "Production" scope

# =====================================================
# DATABASE (Required) - Supabase PostgreSQL
# =====================================================
# Get connection string from Supabase Dashboard:
# https://supabase.com/dashboard → Your Project → Settings → Database
# Look for "Connection string" (Node.js tab)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.jmrgooqidunwswiqhkie.supabase.co:5432/postgres

# In Vercel, set this exact variable name and value:
DATABASE_URL=postgresql://postgres:Xz0vWtzVINE1Jd5l@db.jmrgooqidunwswiqhkie.supabase.co:5432/postgres

# =====================================================
# SUPABASE CONFIGURATION (Required for client auth)
# =====================================================
# From Supabase Dashboard → Settings → API
# Copy "Project URL" and "anon public" key

# In Vercel, set:
# NEXT_PUBLIC_SUPABASE_URL=https://db.jmrgooqidunwswiqhkie.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase

# =====================================================
# AUTHENTICATION (Required)
# =====================================================
# Generate a secure JWT secret:
# Run: openssl rand -base64 32

# In Vercel, set:
# JWT_SECRET=<generated-secret>

# =====================================================
# NODE_ENV
# =====================================================
# In Vercel, set:
# NODE_ENV=production
